---
import Hero from '@components/home/Hero.astro'
import About from '@components/home/About.astro'
import Gallery from '@components/home/Gallery.astro'
import Services from '@components/home/Services.astro'
import Process from '@components/home/Process.astro'
import Contact from '@components/home/Contact.astro'

import Layout from '@layouts/Layout.astro'
import { getCollection } from 'astro:content'

const artworks = await getCollection('artworks')

const featured =
  artworks.find((a) => a.data.kind === 'obra-maestra') ?? artworks[0]
---

<Layout>
  <div class="flex flex-col w-full text-on-surface">
    <Hero artwork={featured} />
    <About />
    <Gallery artworks={artworks} />
    <Services />
    <Process />
    <Contact />
  </div>
</Layout>
