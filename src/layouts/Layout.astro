---
import { Font } from 'astro:assets'
import '../styles/global.css'
import Header from '@components/shared/Header.astro'
import Footer from '@components/shared/Footer.astro'
---

<!doctype html>
<html lang="es" class="dark reveal-on">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="Retratos realistas en blanco y negro ejecutados a mano por Melissa Gutiérrez. Grafito y carbón sobre papel de algodón."
    />
    <title>Melissa Gutiérrez — Retratos en Blanco y Negro</title>
    <script is:inline>
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('reveal-on')
      }
    </script>
    <Font cssVariable="--font-manrope" preload />
  </head>

  <body class="bg-bg text-on-surface font-body text-[15px] leading-[24px] tracking-[0.01em] antialiased">
    <Header />
    <slot />
    <Footer />
    <script>
      import '../scripts/reveal'
    </script>
  </body>
</html>
