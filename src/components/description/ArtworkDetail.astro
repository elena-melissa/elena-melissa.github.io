---
import { Icon } from 'astro-icon/components'
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'

interface Props {
  entry: CollectionEntry<'artworks'>
}

const { entry } = Astro.props
const {
  series,
  image,
  title,
  dimensions,
  availability,
  curatorialStatement,
  support,
  technique,
  year: currentYear,
} = entry.data
const year = currentYear ?? 2026
---

<section class="w-full bg-bg pt-[72px]">
  <div class="w-full bg-surface-lowest/60 backdrop-blur-md">
    <div class="w-full max-w-[1440px] mx-auto px-5 md:px-8 lg:px-16 py-3 flex items-center justify-between">
      <a
        href="/#galeria"
        class="group inline-flex items-center gap-2 text-on-surface-variant transition-colors hover:text-on-surface"
      >
        <Icon
          name="mdi:arrow-left"
          class="text-[18px] leading-[18px] transition-transform duration-300 group-hover:-translate-x-1"
        />
        <span class="font-body text-xs font-medium leading-[16px] tracking-[0.08em] uppercase">
          Volver a la galería
        </span>
      </a>
      <div class="hidden sm:flex items-center gap-4">
        <span class="font-body text-[11px] font-semibold leading-[14px] tracking-[0.12em] uppercase text-outline">
          Catálogo {year} / Serie ‘{series}’
        </span>
        <span class="w-1.5 h-1.5 rounded-full bg-accent/60"></span>
        <span class="font-body text-[11px] font-semibold leading-[14px] tracking-[0.12em] uppercase text-primary">
          Pieza I
        </span>
      </div>
    </div>
  </div>

  <div
    class="w-full flex items-center justify-center px-4 sm:px-6 h-auto sm:h-[calc(100svh-7.5rem)]"
    data-reveal
  >
    {image ? (
      <Image
        inferSize
        alt={
          'Obra ' +
          title +
          ' - Retrato hiperrealista en blanco y negro por Melissa Gutiérrez'
        }
        src={image}
        class="w-full h-full object-contain drop-shadow-[0_24px_48px_rgba(0,0,0,0.75)]"
      />
    ) : null}
  </div>

  <div
    class="w-full max-w-[1440px] mx-auto px-5 md:px-8 lg:px-16 py-4 flex flex-wrap items-center justify-between gap-2"
    data-reveal
  >
    <span class="font-body text-[11px] font-semibold leading-[14px] tracking-[0.12em] uppercase text-outline">
      Barbas de papel rasgado al agua · 300 g/m²
    </span>
    <span class="font-body text-[11px] font-semibold leading-[14px] tracking-[0.12em] uppercase text-outline/60">
      Firmado &amp; Sellado al dorso
    </span>
  </div>

  <div
    id="descripcion"
    class="w-full max-w-[960px] mx-auto px-5 md:px-8 pt-10 pb-24 flex flex-col gap-10"
  >
    <div class="flex flex-col gap-4" data-reveal>
      <div class="flex items-center gap-3">
        <Icon name="mdi:draw" class="text-4xl leading-[16px] text-primary" />
        <span class="font-body text-xs font-medium leading-[16px] tracking-[0.08em] uppercase text-primary">
          Retrato Contemporáneo en Grafito &amp; Carbón
        </span>
      </div>
      <h1 class="font-display text-[48px] font-normal leading-[56px] tracking-[-0.015em] text-ink">
        {title}
      </h1>
      <p class="font-body text-[15px] font-normal leading-[24px] italic text-on-surface-variant m-0">
        {year} · Serie “{series}”, Pieza I (Obra Testimonial)
      </p>
    </div>

    <div
      class="bg-surface-low rounded-xl p-5 shadow-[0_12px_24px_-8px_rgba(0,0,0,0.75)] flex flex-col gap-3"
      data-reveal
    >
      <span class="font-body text-[11px] font-semibold leading-[14px] tracking-[0.12em] uppercase text-outline">
        Ficha Técnica de Conservación
      </span>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="flex flex-col">
          <span class="font-body text-[11px] font-semibold leading-[14px] tracking-[0.12em] uppercase text-outline-variant">
            Técnica
          </span>
          <span class="font-body text-[13px] font-medium leading-[20px] text-on-surface">
            {technique}
          </span>
        </div>
        <div class="flex flex-col">
          <span class="font-body text-[11px] font-semibold leading-[14px] tracking-[0.12em] uppercase text-outline-variant">
            Soporte
          </span>
          <span class="font-body text-[13px] font-medium leading-[20px] text-on-surface">
            {support}
          </span>
        </div>
        <div class="flex flex-col">
          <span class="font-body text-[11px] font-semibold leading-[14px] tracking-[0.12em] uppercase text-outline-variant">
            Dimensiones Hoja
          </span>
          <span class="font-body text-[13px] font-medium leading-[20px] text-on-surface">
            {dimensions}
          </span>
        </div>
        <div class="flex flex-col">
          <span class="font-body text-[11px] font-semibold leading-[14px] tracking-[0.12em] uppercase text-outline-variant">
            Montaje en Vitrina
          </span>
          <span class="font-body text-[13px] font-medium leading-[20px] text-on-surface">
            1050 × 1380 mm · Vidrio Museal UV 99% antirreflejo
          </span>
        </div>
        <div class="flex flex-col">
          <span class="font-body text-[11px] font-semibold leading-[14px] tracking-[0.12em] uppercase text-outline-variant">
            Tiempo de Ejecución
          </span>
          <span class="font-body text-[13px] font-medium leading-[20px] text-on-surface">
            96 horas de intervención directa sobre la obra
          </span>
        </div>
        <div class="flex flex-col">
          <span class="font-body text-[11px] font-semibold leading-[14px] tracking-[0.12em] uppercase text-outline-variant">
            Disponibilidad
          </span>
          <span class="font-body text-[13px] font-medium leading-[20px] text-primary flex items-center gap-1">
            {availability}
          </span>
        </div>
      </div>
    </div>

    <div class="flex flex-col gap-4" data-reveal>
      <h2 class="font-display text-[24px] font-normal leading-[32px] text-ink m-0">
        Memoria Curatorial &amp; Diálogo Emocional
      </h2>
      <div class="flex flex-col gap-3 font-body text-[15px] font-light leading-[24px] text-on-surface-variant">
        <p class="font-display text-[19px] font-normal italic leading-[28px] text-ink m-0">
          “{title}” {curatorialStatement}
        </p>
      </div>
    </div>

    <div
      class="bg-surface-high/80 rounded-xl p-5 shadow-[0_24px_48px_-12px_rgba(0,0,0,0.75)] flex flex-col gap-4 relative overflow-hidden"
      data-reveal
    >
      <div class="absolute -right-12 -bottom-12 w-36 h-36 rounded-full blur-2xl bg-accent/10 pointer-events-none"></div>
      <div class="flex items-start gap-3">
        <div class="w-10 h-10 rounded-lg flex items-center justify-center shrink-0 bg-primary-container text-on-primary-container">
          <Icon
            name="mdi:file-document-edit"
            class="text-[22px] leading-[22px]"
          />
        </div>
        <div class="flex flex-col">
          <span class="font-display text-[24px] font-normal leading-[32px] text-ink">
            ¿Deseas encargar una obra similar?
          </span>
          <p class="font-body text-[13px] font-normal leading-[20px] text-on-surface-variant mt-1">
            Melissa acepta un cupo rigurosamente limitado de encargos privados
            al año en grafito y carbón sobre papel de algodón de conservación.
          </p>
        </div>
      </div>
      <div class="flex flex-col sm:flex-row gap-3 pt-2">
        <a
          href="https://wa.me/5351334138"
          target="_blank"
          rel="noopener noreferrer"
          class="flex-1 inline-flex items-center justify-center gap-2 px-4 py-3 bg-primary-container text-on-primary-container font-body text-xs font-medium tracking-[0.08em] uppercase rounded transition-all"
        >
          <Icon name="mdi:message" class="text-[18px] leading-[18px]" />
          <span>Consultar por WhatsApp</span>
        </a>
        <a
          href="/#contacto"
          class="inline-flex items-center justify-center gap-2 px-4 py-3 bg-surface-lowest text-on-surface font-body text-xs font-medium tracking-[0.08em] uppercase rounded transition-all"
        >
          Consultar Disponibilidad
        </a>
      </div>
    </div>
  </div>
</section>
